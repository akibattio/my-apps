# シークレット（絶対にコミットしない）
.env
.env.*
!.env.example
secrets/
*.pem
*.key
client_secret*.json
*credentials*.json
# トークンを「ファイルとして」保存した場合の保険（.txt/.json のみ。.py 等の実装は対象外）
*token*.txt
*token*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# 取得データ・生成物（個社の実データはリポジトリに残さない）
data/*.csv
data/*.json
# 下位フォルダの取得データも除外（見本の data/samples/ だけ追跡）
data/**/*.json
data/**/*.csv
!data/samples/**
!data/samples/
out/
*.log

# OS / エディタ
.DS_Store
.vscode/
.idea/

# コンソールの実データ（個社数値・Git管理外）
console/data.json
console/daily.json
console/audit.json
console/monthly.json
console/keywords.json
console/breakdowns.json
console/history.json
console/creatives_weekly.json
console/ga4.json
console/assets.json

# 実行ログ
logs/
# wrangler のローカル状態（試験用KV・ログイン情報）。ad-automation/.wrangler と cron-trigger/.wrangler の両方
# ※ Git の除外指定は行の途中にコメントを書けない（書くと指定ごと効かない）
.wrangler/

# Claude Code の手元設定（許可の一覧など・端末ごと）
.claude/settings.local.json
