# Supabase 接続情報（プロジェクト作成後に設定）
# Supabase ダッシュボード → Project Settings → API / Database から取得
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバー側専用（絶対にクライアントへ出さない）
SUPABASE_SERVICE_ROLE_KEY=

# マイグレーション適用用（npm run migrate で使用）
# Supabase ダッシュボード → Project Settings → Database → Connection string → URI
# 例: postgresql://postgres:<DB-PASSWORD>@db.<ref>.supabase.co:5432/postgres
SUPABASE_DB_URL=

# 管理者（Supabase の認証のユーザー ID、カンマ区切り）。未設定なら管理者なし（誰も管理画面に入れない）
# Supabase ダッシュボード → Authentication → Users で、管理者のユーザーの「UID」を見る
ADMIN_USER_IDS=
# 管理者のメールアドレス（カンマ区切り）。会員登録で同じアドレスを使わせないためだけに使う（判定には使わない）
ADMIN_EMAILS=
# 運営への通知（新着・マッチ・持ち主確認）の宛先（カンマ区切り）。未設定なら通知を送らない
ADMIN_NOTIFY_EMAILS=

# メール送信（Resend）。未設定なら通知メールを送らない
RESEND_API_KEY=
# 通知メールの差出人（任意。未設定なら既定の差出人）
NOTIFY_FROM=
# サイトの URL（メール内のリンクに使う）。例: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile（ボット対策）のサイトキー（公開してよい鍵）。未設定なら表示しない
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# 写真から車種を推定する AI（任意。未設定なら使わない）
ANTHROPIC_API_KEY=

# 使っていない合言葉の入口（/gate）用。通常は空のまま
SITE_PASSCODE=
